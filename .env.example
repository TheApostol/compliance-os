# ──────────────────────────────────────────────────────────────
# ComplianceOS — Environment Configuration
# Copy this file to `.env` and fill in values.
# NEVER commit `.env` to git. It's in .gitignore.
# ──────────────────────────────────────────────────────────────

# ── Application ────────────────────────────
APP_ENV=development          # development | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-32+-char-secret
LOG_LEVEL=INFO

# ── API ─────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Database ────────────────────────────────
POSTGRES_USER=complianceos
POSTGRES_PASSWORD=complianceos
POSTGRES_DB=complianceos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://complianceos:complianceos@db:5432/complianceos

# ── Vector DB ───────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                  # optional

# ── Cache ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AI Providers (Primary + Fallback Chain) ──────
# PRIMARY: NVIDIA NIM Free Endpoints (required)
#   Get a free key at https://build.nvidia.com
#   Rate limit: 40 RPM global budget with token bucket + priority queue (T1.2)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RATE_LIMIT_RPM=40

# FALLBACK 1: Anthropic Claude API (recommended for production)
#   Required if using data residency policy enforcement (T1.3)
#   Get API key at https://console.anthropic.com/account/keys
#   Set to enable automatic fallback when NVIDIA rates limit or timeouts
ANTHROPIC_API_KEY=sk-ant-...

# FALLBACK 2: OpenRouter (optional, third-line fallback)
#   Get API key at https://openrouter.ai/account/keys
#   Used only if both NVIDIA and Anthropic are exhausted
OPENROUTER_API_KEY=sk-or-...

# DEPRECATED: Do not use OpenAI API directly
# (Use OpenRouter for OpenAI models instead)
OPENAI_API_KEY=

# ── CORS ────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── Crawler ─────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_BCRA_URL=https://www.bcra.gob.ar/SistemasFinancieros/sf_comunicaciones.asp
CRAWLER_UIF_URL=https://www.uif.gob.ar/uif/index.php/es/normativa

# ── Audit ───────────────────────────────────
AUDIT_HASH_CHAIN_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=2555
# Optional: password for the least-privilege complianceos_audit_logger DB role
# (SELECT, INSERT only on audit_log) created by migration 0010. Set before
# running `alembic upgrade` if you want the role to support password login.
AUDIT_LOGGER_DB_PASSWORD=

# ── Multi-tenancy ───────────────────────────
DEFAULT_TENANT_ID=polkorp
DEFAULT_TENANT_NAME="Polkorp Global Ventures"

# ── Frontend ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ComplianceOS

# ── Auth (external — optional) ────────────────────────────────────
AUTH_MODE=local                      # local | auth0 | clerk
AUTH0_DOMAIN=                        # your-tenant.auth0.com
AUTH0_AUDIENCE=                      # https://api.complianceos.io
CLERK_JWKS_URL=                      # https://clerk.your-app.com/.well-known/jwks.json

# ── Observability ───────────────────────────────────
GRAFANA_PASSWORD=complianceos
