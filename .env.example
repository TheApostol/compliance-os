# ──────────────────────────────────────────────────────────────
# ComplianceOS — Environment Configuration
# Copy this file to `.env` and fill in values.
# NEVER commit `.env` to git. It's in .gitignore.
# ──────────────────────────────────────────────────────────────

# ===== Application =====
APP_NAME=ComplianceOS
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-string-min-64-chars-please
LOG_LEVEL=INFO

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Database (PostgreSQL) =====
POSTGRES_USER=complianceos
POSTGRES_PASSWORD=complianceos_dev_pwd_change_in_prod
POSTGRES_DB=complianceos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://complianceos:complianceos_dev_pwd_change_in_prod@db:5432/complianceos

# ===== Vector DB (Qdrant) =====
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# ===== Cache / Queue (Redis) =====
REDIS_URL=redis://redis:6379/0

# ===== AI Providers =====
# NVIDIA NIM — primary provider (free tier at build.nvidia.com)
# Get key at: https://build.nvidia.com → Account → API Keys
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional fallbacks (leave empty if not using)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ===== Rate limiting =====
NVIDIA_RATE_LIMIT_RPM=40

# ===== Audit & Retention =====
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_HASH_CHAIN_ENABLED=true

# ===== Multi-tenancy =====
DEFAULT_TENANT_ID=polkorp
DEFAULT_TENANT_NAME="Polkorp Global Ventures"

# ===== Frontend =====
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ComplianceOS
