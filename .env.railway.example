# ──────────────────────────────────────────────────────────────
# ComplianceOS — Railway Environment Variables
#
# Set these in Railway → your backend service → Variables tab.
# Railway auto-injects DATABASE_URL and REDIS_URL from plugins.
# ──────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=<generate: python -c "import secrets; print(secrets.token_hex(32))">
LOG_LEVEL=INFO

# ── CORS — set to your Vercel frontend URL ───────────────────
# Example: CORS_ORIGINS=https://compliance-os.vercel.app
# Multiple: CORS_ORIGINS=https://compliance-os.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=https://<your-app>.vercel.app

# ── Database — Railway PostgreSQL plugin sets this automatically ──
# If you need to override, format MUST be: postgresql+asyncpg://...
# Railway provides postgres:// — the app converts it automatically.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db

# ── Cache — Railway Redis plugin sets this automatically ─────
# REDIS_URL=redis://default:pass@host:6379

# ── Vector DB ────────────────────────────────────────────────
# Option A: Qdrant Cloud (https://cloud.qdrant.io — free tier available)
QDRANT_URL=https://<your-cluster>.qdrant.io:6333
QDRANT_API_KEY=<your-qdrant-api-key>

# Option B: Self-hosted Qdrant on Railway (no API key needed)
# QDRANT_URL=http://<qdrant-service>.railway.internal:6333
# QDRANT_API_KEY=

# ── AI (required) ────────────────────────────────────────────
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RATE_LIMIT_RPM=40

# ── Optional AI fallbacks ────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
