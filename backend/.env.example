# ComplianceOS Production Environment Configuration
# Copy this file to .env and fill in the values for your deployment

# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
APP_NAME=ComplianceOS
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=your-secret-key-change-me-in-production

LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════
# API CONFIGURATION
# ═══════════════════════════════════════════════════════════════
API_HOST=0.0.0.0
API_PORT=8000

# CORS Origins (comma-separated for production)
# Example: https://www.polkorp.com,https://polkorp.com,https://api.polkorp.com
CORS_ORIGINS=https://www.polkorp.com,https://polkorp.com,https://api.polkorp.com

# ═══════════════════════════════════════════════════════════════
# DATABASE
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://user:password@prod-db.polkorp.com:5432/compliance_os
POSTGRES_USER=complianceos
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=compliance_os
POSTGRES_HOST=prod-db.polkorp.com
POSTGRES_PORT=5432

# ═══════════════════════════════════════════════════════════════
# VECTOR DATABASE (Qdrant)
# ═══════════════════════════════════════════════════════════════
QDRANT_URL=https://qdrant.polkorp.com:6333
QDRANT_API_KEY=your-qdrant-api-key

# ═══════════════════════════════════════════════════════════════
# CACHE (Redis)
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://prod-redis.polkorp.com:6379/0

# ═══════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═══════════════════════════════════════════════════════════════

# NVIDIA NIM (Primary provider - 40 RPM limit)
NVIDIA_API_KEY=nvapi-your-actual-api-key-from-build.nvidia.com
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_RATE_LIMIT_RPM=40

# Anthropic (Fallback provider)
ANTHROPIC_API_KEY=sk-your-anthropic-key

# OpenRouter (Second fallback provider)
OPENROUTER_API_KEY=your-openrouter-key
OPENAI_API_KEY=sk-your-openai-compatible-key

# ═══════════════════════════════════════════════════════════════
# AUDIT & SECURITY
# ═══════════════════════════════════════════════════════════════
AUDIT_LOG_RETENTION_DAYS=2555
AUDIT_HASH_CHAIN_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# MULTI-TENANCY
# ═══════════════════════════════════════════════════════════════
DEFAULT_TENANT_ID=polkorp
DEFAULT_TENANT_NAME=Polkorp Global Ventures

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════════
# Options: "local", "auth0", "clerk"
AUTH_MODE=local
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_AUDIENCE=https://api.polkorp.com
# CLERK_JWKS_URL=https://clerk.your-app.com/.well-known/jwks.json

# ═══════════════════════════════════════════════════════════════
# CRAWLER
# ═══════════════════════════════════════════════════════════════
CRAWLER_ENABLED=true
CRAWLER_BCRA_URL=https://www.bcra.gob.ar/SistemasFinancieros/sf_comunicaciones.asp
CRAWLER_UIF_URL=https://www.uif.gob.ar/uif/index.php/es/normativa

# ═══════════════════════════════════════════════════════════════
# OBSERVABILITY (Optional but recommended)
# ═══════════════════════════════════════════════════════════════
# SENTRY_DSN=https://your-key@sentry.io/your-project-id
# DATADOG_API_KEY=your-datadog-api-key
# NEW_RELIC_LICENSE_KEY=your-new-relic-key
